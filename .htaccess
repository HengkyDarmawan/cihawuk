# Fallback bila DocumentRoot menunjuk ke root proyek (mis. subdomain shared hosting).
# Seluruh request dipetakan ke public/, sehingga application/, system/, vendor/,
# storage/ dan .env tidak pernah dilayani langsung. Virtual host yang DocumentRoot-nya
# folder public/ tidak membaca file ini.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
