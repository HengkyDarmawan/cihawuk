# Salin menjadi .env lalu jalankan:  php public/index.php tools generate_keys
# Jangan pernah commit .env. Nilai kosong untuk key akan diisi generator.

APP_ENV=development
APP_BASE_URL=http://cihawuk.test/
# Alamat lain yang sah (dipisah koma), mis. http://localhost/cihawuk/
APP_BASE_URL_ALIASES=
APP_TIMEZONE=Asia/Jakarta
APP_NAME="Desa Cihawuk"
APP_DISPLAY_ERRORS=true
# IP proxy tepercaya (dipisah koma). Kosong = tidak mempercayai X-Forwarded-For.
APP_TRUSTED_PROXIES=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cihawuk_digital
DB_USERNAME=cihawuk_app
DB_PASSWORD=
# Kredensial DDL khusus migration (tools migrate). Aplikasi web tidak memakainya.
DB_MIGRATE_USERNAME=cihawuk_migrate
DB_MIGRATE_PASSWORD=

# Key kriptografis (base64). Diisi oleh tools generate_keys; masing-masing untuk satu keperluan.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=1
APP_MFA_KEY=
APP_TOKEN_PEPPER=
APP_RATE_LIMIT_KEY=
APP_CI_ENCRYPTION_KEY=

SESSION_DRIVER=database
SESSION_SAVE_PATH=ci_sessions
COOKIE_SECURE=false
# Sesi pengelola (menit)
SESSION_ADMIN_IDLE=30
SESSION_ADMIN_ABSOLUTE=480
# Sesi warga (menit)
SESSION_RESIDENT_IDLE=60
SESSION_RESIDENT_ABSOLUTE=720

MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="Pelayanan Desa Cihawuk"

STORAGE_PRIVATE_PATH=
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"

FEATURE_LETTERS=false
FEATURE_REMEMBER_ME=false
FEATURE_PUBLIC_SERVICE_STATS=false
FEATURE_THREE_HERO=true
FEATURE_MFA_ENFORCE_PRIVILEGED=false
FEATURE_PUBLIC_CACHE=true
# Pemutus darurat modul. Status sebenarnya dikelola di Pengaturan -> Modul (tabel feature_modules);
# nilai false di sini memaksa modul nonaktif, nilai true tidak memaksa modul menjadi aktif.
FEATURE_ASSET_MANAGEMENT=true
FEATURE_PUBLIC_ASSET_QR=true
FEATURE_WAREHOUSE=true
FEATURE_ORGANIZATION_TREE=true

# Mode demonstrasi: menandai seluruh halaman publik sebagai data contoh dan memaksa noindex.
# WAJIB false sebelum go-live, dan jalankan `tools purge_demo`.
DEMO_MODE=false
